<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="PreferenceThemeOverlay.Grouped" parent="PreferenceThemeOverlay">
        <item name="checkBoxPreferenceStyle">@style/Preference.CheckBoxPreference.Grouped</item>
        <item name="switchPreferenceStyle">@style/Preference.SwitchPreference.Grouped</item>
        <item name="switchPreferenceCompatStyle">@style/Preference.SwitchPreferenceCompat.Grouped</item>
        <item name="preferenceCategoryStyle">@style/Preference.Category.Grouped</item>
    </style>

    <style name="Preference.Category.Grouped" parent="Preference.Category.Material">
        <item name="android:layout">@layout/preference_category_grouped</item>
        <!-- Used by com.takisoft.preferencex.PreferenceCategory, which otherwise tints the title with colorAccent -->
        <item name="pref_categoryColor">?attr/colorPrimary</item>
    </style>

    <!-- Toggles are shown as switches, like in the Android system settings -->
    <style name="Preference.CheckBoxPreference.Grouped" parent="Preference.CheckBoxPreference.Material">
        <item name="android:widgetLayout">@layout/preference_widget_grouped_checkbox</item>
    </style>

    <style name="Preference.SwitchPreference.Grouped" parent="Preference.SwitchPreference.Material">
        <item name="android:widgetLayout">@layout/preference_widget_grouped_switch</item>
    </style>

    <style name="Preference.SwitchPreferenceCompat.Grouped" parent="Preference.SwitchPreferenceCompat.Material">
        <item name="android:widgetLayout">@layout/preference_widget_grouped_switch_compat</item>
    </style>

</resources>
