<?xml version="1.0" encoding="utf-8"?>
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedAttribute"
    >

    <font
        android:font="@font/google_sans_flex"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 500"
        android:fontWeight="400"
        app:font="@font/google_sans_flex"
        app:fontStyle="normal"
        app:fontVariationSettings="'wght' 500"
        app:fontWeight="400"
        />

    <font
        android:font="@font/google_sans_flex"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 700"
        android:fontWeight="700"
        app:font="@font/google_sans_flex"
        app:fontStyle="normal"
        app:fontVariationSettings="'wght' 700"
        app:fontWeight="700"
        />

</font-family>
