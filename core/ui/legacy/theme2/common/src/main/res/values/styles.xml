<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.App.AppBarLayout" parent="Widget.Material3Expressive.AppBarLayout">
        <item name="android:background">?attr/colorScreenBackground</item>
    </style>

    <style name="Widget.App.Toolbar" parent="Widget.Material3Expressive.Toolbar">
        <item name="android:background">?attr/colorScreenBackground</item>
        <item name="titleTextAppearance">?attr/textAppearanceTitleLarge</item>
    </style>

    <style name="Widget.App.SearchView" parent="Widget.AppCompat.SearchView">
        <item name="queryBackground">@drawable/theme2_search_query_background</item>
        <item name="submitBackground">@null</item>
    </style>

    <style name="Widget.App.ActionMode.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
</resources>
