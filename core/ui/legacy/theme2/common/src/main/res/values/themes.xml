<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Empty base themes that can be easily replaced by RRO (Runtime Resource Overlay) themes -->
    <style name="Theme2.Main.Light.Base" parent="Theme.Material3Expressive.Light.NoActionBar" />
    <style name="Theme2.Main.Dark.Base" parent="Theme.Material3Expressive.Dark.NoActionBar" />
    <style name="Theme2.Main.DayNight.Base" parent="Theme.Material3Expressive.DayNight.NoActionBar" />

    <!-- Common main themes -->
    <style name="Theme2.Main.Light.Common" parent="Theme2.Main.Light.Base">
        <!-- Draw action mode above content -->
        <item name="windowActionModeOverlay">true</item>

        <item name="android:textColorHighlight">?attr/colorPrimaryFixedDim</item>

        <item name="textAppearanceDisplayLarge">@style/TextAppearance.Theme2.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.Theme2.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.Theme2.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Theme2.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Theme2.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Theme2.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Theme2.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Theme2.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Theme2.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Theme2.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Theme2.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Theme2.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Theme2.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Theme2.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Theme2.LabelSmall</item>

        <item name="android:textAppearance">@style/TextAppearance.Theme2.Default</item>
        <item name="android:textAppearanceSmall">@style/TextAppearance.Theme2.Small</item>
        <item name="android:textAppearanceMedium">@style/TextAppearance.Theme2.Medium</item>
        <item name="android:textAppearanceLarge">@style/TextAppearance.Theme2.Large</item>
        <item name="android:textAppearanceListItem">@style/TextAppearance.Theme2.BodyLarge</item>
        <item name="android:textAppearanceListItemSecondary">@style/TextAppearance.Theme2.BodyMedium</item>
        <item name="android:textAppearanceListItemSmall">@style/TextAppearance.Theme2.BodyLarge</item>

        <item name="colorScreenBackground">?attr/colorSurfaceContainer</item>
        <item name="colorContainerBackground">?attr/colorSurfaceContainerLowest</item>
        <item name="android:windowBackground">?attr/colorScreenBackground</item>
        <item name="popupMenuBackground">@drawable/theme2_popup_menu_background</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Material3.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Material3.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Material3.LargeComponent</item>
    </style>

    <style name="Theme2.Main.Dark.Common" parent="Theme2.Main.Dark.Base">
        <!-- Draw action mode above content -->
        <item name="windowActionModeOverlay">true</item>

        <item name="textAppearanceDisplayLarge">@style/TextAppearance.Theme2.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.Theme2.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.Theme2.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Theme2.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Theme2.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Theme2.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Theme2.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Theme2.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Theme2.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Theme2.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Theme2.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Theme2.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Theme2.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Theme2.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Theme2.LabelSmall</item>

        <item name="android:textAppearance">@style/TextAppearance.Theme2.Default</item>
        <item name="android:textAppearanceSmall">@style/TextAppearance.Theme2.Small</item>
        <item name="android:textAppearanceMedium">@style/TextAppearance.Theme2.Medium</item>
        <item name="android:textAppearanceLarge">@style/TextAppearance.Theme2.Large</item>
        <item name="android:textAppearanceListItem">@style/TextAppearance.Theme2.BodyLarge</item>
        <item name="android:textAppearanceListItemSecondary">@style/TextAppearance.Theme2.BodyMedium</item>
        <item name="android:textAppearanceListItemSmall">@style/TextAppearance.Theme2.BodyLarge</item>

        <item name="colorScreenBackground">?attr/colorSurface</item>
        <item name="colorContainerBackground">?attr/colorSurfaceContainer</item>
        <item name="android:windowBackground">?attr/colorScreenBackground</item>
        <item name="popupMenuBackground">@drawable/theme2_popup_menu_background</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Material3.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Material3.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Material3.LargeComponent</item>
    </style>

    <style name="Theme2.Main.DayNight.Common" parent="Theme2.Main.Light.Base" />

    <!-- Main themes -->
    <style name="Theme2.Main.Light" parent="Theme2.Main.Light.Common" />

    <style name="Theme2.Main.Dark" parent="Theme2.Main.Dark.Common" />

    <style name="Theme2.Main.DayNight" parent="Theme2.Main.Light" />

    <!--
    Android uses the theme configured in the manifest for its initial startup animation. On Android versions that don't
    support switching the system theme we have to optimize for either the light or dark theme. We chose the dark theme
    because it's often used in low light conditions and a bright flash during startup is more annoying than using a dark
    startup animation when the app is configured to use the light theme.

    On modern Android versions we override Theme2.Main.Startup to use Theme2.Main.DayNight instead. That way the startup
    animation will match the app theme if the app follows the system theme (which is the default configuration).
    See <values-v28/themes.xml>.
    -->
    <style name="Theme2.Main.Startup" parent="Theme2.Main.Dark" />

</resources>
